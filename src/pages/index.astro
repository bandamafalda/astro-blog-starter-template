<html lang="el">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Banda Mafalda</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{

      width:100%;
      height:100vh;

      overflow:hidden;

      display:flex;
      justify-content:center;
      align-items:center;

      position:relative;

      font-family:
      Arial,
      Helvetica,
      sans-serif;

      background:
      linear-gradient(
        rgba(0,0,0,.45),
        rgba(0,0,0,.72)
      ),
      url('/background.png');

      background-size:cover;
      background-position:center;
      background-repeat:no-repeat;

      color:white;
    }

    body::before{

      content:"";

      position:absolute;
      inset:0;

      background:
      radial-gradient(
        circle at bottom,
        rgba(255,255,255,.05),
        transparent 30%
      );

      pointer-events:none;
    }

    .fog{

      position:absolute;
      bottom:-5%;

      width:100%;
      height:30%;

      background:
      radial-gradient(
        circle,
        rgba(255,255,255,.08),
        transparent 60%
      );

      filter:blur(60px);

      opacity:.75;

      pointer-events:none;
    }

    .container{

      position:relative;
      z-index:2;

      text-align:center;

      display:flex;
      flex-direction:column;
      align-items:center;

      padding:40px;
    }

    .logo{

      width:min(820px,85vw);

      opacity:.97;

      filter:
      drop-shadow(0 0 12px rgba(255,255,255,.04));
    }

    .subtitle{

      margin-top:20px;

      color:
      rgba(255,255,255,.62);

      font-size:.72rem;

      letter-spacing:.45rem;

      text-transform:uppercase;
    }

    .divider{

      width:90px;
      height:1px;

      margin:38px 0;

      background:
      rgba(255,255,255,.18);
    }

    .under{

      font-size:
      clamp(1.4rem,4vw,3rem);

      letter-spacing:.55rem;

      font-weight:300;

      color:
      rgba(255,255,255,.92);
    }

    .text{

      margin-top:24px;

      color:
      rgba(255,255,255,.55);

      font-size:.95rem;

      line-height:1.9;

      letter-spacing:.18rem;

      text-transform:uppercase;
    }

    .contact-btn{

      display:inline-flex;

      justify-content:center;
      align-items:center;

      margin-top:48px;

      padding:14px 34px;

      border:
      1px solid rgba(255,255,255,.16);

      color:white;

      text-decoration:none;

      font-size:.72rem;

      letter-spacing:.3rem;

      text-transform:uppercase;

      background:
      rgba(255,255,255,.03);

      backdrop-filter:blur(6px);

      transition:.25s ease;
    }

    .contact-btn:hover{

      background:
      rgba(255,255,255,.08);

      border-color:
      rgba(255,255,255,.3);

      transform:
      translateY(-2px);
    }

    @media (max-width:768px){

      .logo{
        width:92vw;
      }

      .subtitle{

        font-size:.58rem;

        letter-spacing:.28rem;
      }

      .under{

        letter-spacing:.28rem;
      }

      .text{

        font-size:.78rem;

        letter-spacing:.12rem;

        line-height:1.7;
      }

    }

  </style>
</head>

<body>

  <div class="fog"></div>

  <div class="container">

    <img
      src="/logo.jpeg"
      alt="Banda Mafalda"
      class="logo"
    />

    <div class="subtitle">
      MUSIC / STORIES / VISUALS
    </div>

    <div class="divider"></div>

    <div class="under">
      UNDER CONSTRUCTION
    </div>

    <div class="text">
      Something new is being prepared.
      <br/>
      Stay tuned.
    </div>

    <a
      href="mailto:info@bandamafalda.com"
      class="contact-btn"
    >
      CONTACT
    </a>

  </div>

</body>
</html>
