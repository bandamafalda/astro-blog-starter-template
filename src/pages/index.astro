<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Banda Mafalda</title>

    <style>
      body {
        margin: 0;
        background: #0d0d0d;
        color: white;
        font-family: Arial, sans-serif;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .container {
        max-width: 700px;
        padding: 20px;
      }

      h1 {
        font-size: 4rem;
        margin-bottom: 10px;
      }

      p {
        color: #bdbdbd;
        line-height: 1.6;
        font-size: 1.2rem;
      }

      .button {
        display: inline-block;
        margin-top: 30px;
        padding: 14px 28px;
        border: 1px solid white;
        text-decoration: none;
        color: white;
        transition: 0.3s;
      }

      .button:hover {
        background: white;
        color: black;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h1>Banda Mafalda</h1>

      <p>
        Sound • Events • Production
      </p>

      <p>
        Official website under construction.
      </p>

      <a class="button" href="mailto:info@bandamafalda.com">
        Contact
      </a>
    </div>
  </body>
</html>
