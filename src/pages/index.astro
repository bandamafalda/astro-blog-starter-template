---

<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Banda Mafalda</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          linear-gradient(
            rgba(0,0,0,.18),
            rgba(0,0,0,.62)
          ),
          url("/background.png");

        background-size: cover;
        background-position: center;

        color: white;

        font-family: Arial, Helvetica, sans-serif;

        display: grid;
        place-items: center;

        overflow: hidden;
      }

      .content {
        text-align: center;
        padding: 32px;
      }

      .logo {
        width: min(740px, 88vw);

        opacity: .96;

        filter:
          drop-shadow(0 8px 24px rgba(0,0,0,.45))
          drop-shadow(0 0 14px rgba(255,255,255,.06));
      }

      .divider {
        width: 92px;
        height: 1px;

        margin: 48px auto 42px;

        background: rgba(255,255,255,.28);
      }

      .status {
        font-size: clamp(1.25rem, 3.2vw, 2.35rem);

        letter-spacing: .38em;

        color: rgba(255,255,255,.88);
      }

      .message {
        margin-top: 32px;

        color: rgba(255,255,255,.62);

        font-size: .9rem;

        letter-spacing: .34em;

        line-height: 2;
      }

      .contact-btn {
        margin-top: 70px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 190px;
        height: 52px;

        border: 1px solid rgba(255,255,255,.24);
        border-radius: 11px;

        color: rgba(255,255,255,.86);

        text-decoration: none;

        letter-spacing: .28em;

        font-size: .78rem;

        transition: .18s ease;

        background: rgba(255,255,255,.02);
      }

      .contact-btn:hover {
        border-color: rgba(255,255,255,.72);

        background: rgba(255,255,255,.08);
      }

      @media (max-width:640px) {

        .logo {
          width: 82vw;
        }
        .content { 
          padding: 20px;
          transform: translateY(-3vh);
        }
        .status {
          font-size: 1rem;

          letter-spacing: .16em;
        }

        .message {
          font-size: .68rem;

          letter-spacing: .12em;
        }

        .contact-btn {
          margin-top: 42px;
        }

      }
    </style>
  </head>

  <body>

    <main class="content">

      <img
        src="/logo.png"
        alt="Banda Mafalda"
        class="logo"
      />

      <div class="divider"></div>

      <div class="status">
        UNDER CONSTRUCTION
      </div>

      <div class="message">
        SOMETHING IS BEING MADE.
        <br />
        STAY TUNED.
      </div>

      <a
        href="mailto:info@bandamafalda.com"
        class="contact-btn"
      >
        CONTACT
      </a>

    </main>

  </body>
</html>
