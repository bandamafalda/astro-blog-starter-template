---
---

<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Banda Mafalda — official website under construction." />

    <title>Banda Mafalda | Under Construction</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        background: #050505;
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
        overflow: hidden;
      }

      .page {
        position: relative;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 32px;
        text-align: center;
        background:
          linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.62)),
          url("/background.png");
        background-size: cover;
        background-position: center;
      }

      .page::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.045), transparent 28%),
          radial-gradient(circle at 50% 100%, rgba(255, 255, 255, 0.08), transparent 34%);
        pointer-events: none;
      }

      .content {
        position: relative;
        z-index: 2;
        width: min(920px, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .logo {
        width: min(740px, 88vw);
        height: auto;
        opacity: 0.96;
        filter:
          drop-shadow(0 8px 24px rgba(0, 0, 0, 0.45))
          drop-shadow(0 0 14px rgba(255, 255, 255, 0.06));
      }

      .divider {
        width: 92px;
        height: 1px;
        margin: 48px auto 42px;
        background: rgba(255, 255, 255, 0.28);
      }

      .status {
        font-size: clamp(1.25rem, 3.2vw, 2.35rem);
        font-weight: 400;
        letter-spacing: 0.38em;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.88);
      }

      .message {
        margin-top: 32px;
        color: rgba(255, 255, 255, 0.62);
        font-size: clamp(0.72rem, 1.8vw, 0.96rem);
        letter-spacing: 0.34em;
        line-height: 2.1;
      }

      .socials {
        display: flex;
        justify-content: center;
        gap: 18px;
        margin-top: 70px;
      }

      .socials a {
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 11px;
        color: rgba(255, 255, 255, 0.78);
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        transition: 180ms ease;
      }

      .socials a:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.72);
        background: rgba(255, 255, 255, 0.08);
      }

      @media (max-width: 640px) {
        .page {
          padding: 24px;
          background-position: center bottom;
        }

        .logo {
          width: 94vw;
        }

        .divider {
          margin: 36px auto 34px;
        }

        .status {
          letter-spacing: 0.22em;
          font-size: 1.15rem;
        }

        .message {
          margin-top: 26px;
          letter-spacing: 0.18em;
          font-size: 0.72rem;
        }

        .socials {
          margin-top: 54px;
          gap: 12px;
        }

        .socials a {
          width: 42px;
          height: 42px;
          font-size: 0.7rem;
        }
      }
    
.contact-btn{

  display:inline-flex;

  justify-content:center;
  align-items:center;

  margin-top:42px;

  padding:14px 34px;

  border:
  1px solid rgba(255,255,255,.18);

  color:white;

  text-decoration:none;

  letter-spacing:.28rem;

  font-size:.72rem;

  transition:.25s ease;

  background:
  rgba(255,255,255,.03);

  backdrop-filter:blur(4px);
}

.contact-btn:hover{

  background:
  rgba(255,255,255,.08);

  border-color:
  rgba(255,255,255,.32);

  transform:
  translateY(-2px);
}

</style>
  </head>

  <body>
    <main class="page">
      <section class="content" aria-label="Banda Mafalda under construction">
        <img src="/logo.png" alt="Banda Mafalda" class="logo" />

        <div class="divider"></div>

        <h1 class="status">UNDER CONSTRUCTION</h1>

        <p class="message">
          SOMETHING IS BEING MADE.<br />
          STAY TUNED.
        </p>

        <nav class="socials" aria-label="Social links">
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="Facebook">FB</a>
          <a href="#" aria-label="YouTube">YT</a>
          <a href="#" aria-label="Spotify">SP</a>
        </nav>
      </section>
    </main>
  </body>
</html>
